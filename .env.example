# ==========================================
# APNA BAZAR - GITHUB DATABASE CONFIGURATION
# ==========================================
# Use these environment variables locally in .env.local
# AND add them in Vercel / Netlify Dashboard -> Project Settings -> Environment Variables

# 1. Your GitHub Personal Access Token (Classic PAT with 'repo' scope)
# Generate from: https://github.com/settings/tokens (classic) -> Select 'repo'
GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# 2. Your GitHub Account Username or Organization Name
GITHUB_OWNER=your-github-username

# 3. Your GitHub Repository Name where Apna Bazar data is stored
GITHUB_REPO=apna-bazar

# 4. Target Branch (default: main)
GITHUB_BRANCH=main

# 5. Public Site URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
